# Public site URL (used for metadata and sitemap)
NEXT_PUBLIC_SITE_URL=https://sebastianarias.dev

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://pklpmenxykyzpwcnbxmm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only secret key (sb_secret_...). NEVER expose it or prefix it with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Random 64-char hex string used to anonymize visitors (openssl rand -hex 32)
ANALYTICS_SALT=

# ---------- AI chat (server-only keys) ----------
# Which provider to use: groq (free tier) or anthropic. If unset, Groq is used when its key exists.
AI_PROVIDER=groq

# Groq — free tier: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: defaults to openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic (Claude) — switch AI_PROVIDER=anthropic once you add credits
ANTHROPIC_API_KEY=
# Optional: defaults to claude-haiku-4-5 (cheapest/fastest)
ANTHROPIC_MODEL=claude-haiku-4-5
